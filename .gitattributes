# Normalize line endings and diff behaviour for the whole repository.
* text=auto eol=lf

# Source
*.html text eol=lf linguist-language=HTML
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Binary assets — never diff or merge these as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated/committed artifacts should not inflate language stats or diffs.
public/og-image.png linguist-generated=true
public/icon-192.png linguist-generated=true
public/icon-512.png linguist-generated=true
